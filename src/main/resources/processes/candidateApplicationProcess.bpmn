<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://justjava.com/recruitment">
  <process id="candidateApplicationProcess" name="Candidate Application" isExecutable="true">
    <startEvent id="start"/>
    <userTask id="screeningTask" name="Recruiter Screening" flowable:candidateGroups="humanResource"/>
    <serviceTask id="recordScreening" name="Record Screening Decision" flowable:delegateExpression="${processRecruitmentDecisionDelegate}"/>
    <exclusiveGateway id="screeningDecision"/>
    <userTask id="assessmentTask" name="Candidate Assessment" flowable:candidateGroups="humanResource"/>
    <serviceTask id="recordAssessment" name="Record Assessment Decision" flowable:delegateExpression="${processRecruitmentDecisionDelegate}"/>
    <exclusiveGateway id="assessmentDecision"/>
    <userTask id="interviewTask" name="Candidate Interview Decision" flowable:candidateGroups="humanResource"/>
    <serviceTask id="recordInterview" name="Record Interview Decision" flowable:delegateExpression="${processRecruitmentDecisionDelegate}"/>
    <exclusiveGateway id="interviewDecision"/>
    <userTask id="checksTask" name="Pre-employment Checks" flowable:candidateGroups="humanResource"/>
    <serviceTask id="recordChecks" name="Record Checks Decision" flowable:delegateExpression="${processRecruitmentDecisionDelegate}"/>
    <exclusiveGateway id="checksDecision"/>
    <userTask id="offerTask" name="Employment Offer Outcome" flowable:candidateGroups="humanResource"/>
    <serviceTask id="recordOffer" name="Record Offer Outcome" flowable:delegateExpression="${processRecruitmentDecisionDelegate}"/>
    <exclusiveGateway id="offerDecision"/>
    <userTask id="preEmploymentTask" name="Complete Pre-employment Information" flowable:candidateGroups="humanResource"/>
    <endEvent id="readyForOnboarding"/><endEvent id="rejectedEnd"/><endEvent id="heldEnd"/><endEvent id="offerDeclinedEnd"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="screeningTask"/><sequenceFlow id="f2" sourceRef="screeningTask" targetRef="recordScreening"/><sequenceFlow id="f3" sourceRef="recordScreening" targetRef="screeningDecision"/>
    <sequenceFlow id="sAdvance" sourceRef="screeningDecision" targetRef="assessmentTask"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'ADVANCE'}]]></conditionExpression></sequenceFlow><sequenceFlow id="sReject" sourceRef="screeningDecision" targetRef="rejectedEnd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'REJECT'}]]></conditionExpression></sequenceFlow><sequenceFlow id="sHold" sourceRef="screeningDecision" targetRef="heldEnd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'HOLD'}]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f4" sourceRef="assessmentTask" targetRef="recordAssessment"/><sequenceFlow id="f5" sourceRef="recordAssessment" targetRef="assessmentDecision"/>
    <sequenceFlow id="aAdvance" sourceRef="assessmentDecision" targetRef="interviewTask"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'ADVANCE'}]]></conditionExpression></sequenceFlow><sequenceFlow id="aReject" sourceRef="assessmentDecision" targetRef="rejectedEnd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'REJECT'}]]></conditionExpression></sequenceFlow><sequenceFlow id="aHold" sourceRef="assessmentDecision" targetRef="heldEnd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'HOLD'}]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f6" sourceRef="interviewTask" targetRef="recordInterview"/><sequenceFlow id="f7" sourceRef="recordInterview" targetRef="interviewDecision"/>
    <sequenceFlow id="iAdvance" sourceRef="interviewDecision" targetRef="checksTask"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'ADVANCE'}]]></conditionExpression></sequenceFlow><sequenceFlow id="iReject" sourceRef="interviewDecision" targetRef="rejectedEnd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'REJECT'}]]></conditionExpression></sequenceFlow><sequenceFlow id="iHold" sourceRef="interviewDecision" targetRef="heldEnd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'HOLD'}]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f8" sourceRef="checksTask" targetRef="recordChecks"/><sequenceFlow id="f9" sourceRef="recordChecks" targetRef="checksDecision"/>
    <sequenceFlow id="cAdvance" sourceRef="checksDecision" targetRef="offerTask"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'ADVANCE'}]]></conditionExpression></sequenceFlow><sequenceFlow id="cReject" sourceRef="checksDecision" targetRef="rejectedEnd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'REJECT'}]]></conditionExpression></sequenceFlow><sequenceFlow id="cHold" sourceRef="checksDecision" targetRef="heldEnd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'HOLD'}]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f10" sourceRef="offerTask" targetRef="recordOffer"/><sequenceFlow id="f11" sourceRef="recordOffer" targetRef="offerDecision"/>
    <sequenceFlow id="oAccept" sourceRef="offerDecision" targetRef="preEmploymentTask"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'ACCEPT_OFFER'}]]></conditionExpression></sequenceFlow><sequenceFlow id="oDecline" sourceRef="offerDecision" targetRef="offerDeclinedEnd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionOutcome == 'DECLINE_OFFER'}]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="f12" sourceRef="preEmploymentTask" targetRef="readyForOnboarding"/>
  </process>
</definitions>
